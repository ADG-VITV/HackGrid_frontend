# ---------------------------------------------------------------------------
# HackGrid frontend — environment
# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time.
# Change one on Vercel → redeploy for it to take effect.
# ---------------------------------------------------------------------------

# Public URL of the backend (no trailing slash). REQUIRED.
# The browser opens its Socket.IO connection here, and the server actions
# call its REST API here unless BACKEND_URL overrides them.
#   local:  http://localhost:4000
#   Render: https://hackgrid-backend.onrender.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Optional, server-only. A different URL for the server actions to use
# (e.g. an internal address). Defaults to NEXT_PUBLIC_BACKEND_URL.
# BACKEND_URL=

# Optional, server-only. Must match ADMIN_API_KEY on the backend; unlocks the
# organiser (admin) actions in production. Never prefix with NEXT_PUBLIC_.
# ADMIN_API_KEY=

# Firebase web app config (Firebase console → Project settings → Your apps).
# These are public identifiers, safe to expose; Firebase secures them by
# authorised domains, not secrecy.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
